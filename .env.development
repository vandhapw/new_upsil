DJANGO_ENV=development
DEBUG=True
SECRET_KEY=dev-secret-key

# Database (example: local SQLite or dev Postgres)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# API base URL (development can point to staging or same server)
API_BASE_URL=http://localhost:8005/backend

# Email (development account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_dev_email@gmail.com
EMAIL_HOST_PASSWORD=your_dev_password